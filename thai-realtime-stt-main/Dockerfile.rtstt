# RealtimeSTT (Whisper/CTranslate2) — อิมเมจของโปรเจกต์นี้
#
# ต่อยอดจาก montg1/realtimestt:v1.0-GPU ไม่ได้สร้างใหม่จากศูนย์ เพราะชุด dependency
# ในนั้น (torch 2.3.1+cu121, faster-whisper 1.0.2, ctranslate2 4.3.1, portaudio)
# ใช้งานได้จริงอยู่แล้ว การไล่ pin ใหม่ทั้งชุดมีแต่ความเสี่ยง ไม่ได้อะไรกลับมา
#
#   docker build -f Dockerfile.rtstt -t montg1/realtimestt:v2.0-GPU .
#
# น้ำหนักโมเดลไม่ได้ฝังไว้ — mount ./models เข้า /models ตอนรัน (ดู start.sh)
# อิมเมจจะได้ไม่บวมอีก 3.2 GB และเปลี่ยนโมเดลได้โดยไม่ต้อง build ใหม่

FROM montg1/realtimestt:v1.0-GPU

# ของเดิมฮาร์ดโค้ด beam_size=1 และคอมเมนต์ initial_prompt/suppress_tokens ทิ้ง
# ทำให้ค่าใน recorder_config ถูกเมินทั้งหมด — ดู NOTES.md ข้อ 2
COPY patch/audio_recorder.py /app/RealtimeSTT/audio_recorder.py

COPY example_browserclient/server.py /app/example_browserclient/server.py
