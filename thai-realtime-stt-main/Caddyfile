# HTTPS ให้หน้าเว็บ เพื่อให้ Chrome ยอมปล่อยไมโครโฟน
#
# getUserMedia ทำงานเฉพาะบน secure context — https หรือ http://localhost เท่านั้น
# LAN IP ธรรมดาไม่เข้าข่าย ไม่มีข้อยกเว้นให้ IP วงใน
#
# หน้าเว็บกับ websocket อยู่ origin เดียวกันโดยตั้งใจ ถ้าแยก wss ไปคนละพอร์ต
# เบราว์เซอร์จะปฏิเสธ cert ของพอร์ตนั้นเงียบ ๆ ตอน handshake โดยไม่มีหน้าให้กดยอมรับ
# รวมไว้พอร์ตเดียวจึงกดผ่าน cert warning ครั้งเดียวแล้วใช้ได้ทั้งสองอย่าง
#
# cert ที่ Caddy ออกเองมีอายุ 12 ชั่วโมง กดยอมรับทีละใบไม่ไหว ให้ติดตั้ง root CA
# ที่เครื่อง client แทน (อายุ 10 ปี):
#   docker cp stt-caddy:/data/caddy/pki/authorities/local/root.crt .

# default_sni จำเป็นเพราะไซต์นี้เป็น IP ไม่ใช่ชื่อโดเมน — สเปก TLS ห้ามใส่ IP ใน SNI
# เบราว์เซอร์จึงต่อมาแบบไม่มี ServerName และ Caddy จะหา cert ไม่เจอ จบด้วย handshake error
{
	auto_https disable_redirects
	default_sni {$SERVER_IP:192.168.10.234}
}

https://{$SERVER_IP:192.168.10.234}:9121 {
	bind 0.0.0.0
	tls internal

	log {
		output stdout
		format console
	}

	# client.js/prove.js เดิมต่อที่ /ws — ชี้ไป endpoint จริงของ FastAPI ให้
	# จะได้ไม่ต้องแก้ฝั่งหน้าเว็บตอนย้ายมาเป็น API
	handle /ws {
		rewrite * /v1/stream
		reverse_proxy {$API_HOST:api}:8000
	}

	handle /v1/* {
		reverse_proxy {$API_HOST:api}:8000
	}

	# Swagger UI ของ FastAPI ไว้ลองยิง API จากเบราว์เซอร์ได้เลย
	handle /docs* {
		reverse_proxy {$API_HOST:api}:8000
	}
	handle /openapi.json {
		reverse_proxy {$API_HOST:api}:8000
	}

	handle {
		root * /srv
		file_server
	}
}
