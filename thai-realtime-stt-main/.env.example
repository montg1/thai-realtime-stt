# คัดลอกเป็น .env แล้วแก้ตามเครื่อง — docker compose อ่านอัตโนมัติ
SERVER_IP=192.168.10.234
HTTPS_PORT=9121

# โมเดล — .nemo ในโวลุ่ม (โหลดด้วย profile bootstrap) หรือใส่ชื่อ repo บน HuggingFace
ASR_MODEL=/models/nemo/pathumma-stt-th-fastconformer-rnnt-large.nemo
DIARIZE=1

# ค่าจูน ปรับได้โดยไม่ต้อง build ใหม่ — ที่มาของแต่ละค่าอยู่ในคอมเมนต์ของ typhoon_server.py
MAX_SEGMENT=5.0
SEG_OVERLAP=0.6
DIAR_HOP=0.25
DIAR_WINDOW=3.0
DIAR_CHANGE_WIN=0

# ต้องมีเฉพาะตอนใช้ dataset/โมเดลที่ gated
HF_TOKEN=
